# Environnement Python local — recréé depuis requirements.txt
.venv/
__pycache__/
*.py[cod]

# Clés privées ECDH (PKCS8, mode 0600).
# Recréées par scripts/e2ee.py au premier pub-test.py --e2ee
# ou sub-decrypt.py : keys/{id}.priv
keys/*.priv

# Annuaire des clés publiques, écrit par enrollment_service/app.py
# au premier POST /devices/<id>/pubkey.
enrollment_service/state.json

.DS_Store
